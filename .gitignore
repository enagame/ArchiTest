# .gitignore installed by AIGS at the root of every Unreal Engine project it manages.
# Goal: commit source (Content, Config, Source, Plugins source) - never local build output,
# caches, or per-workstation editor state, all of which is regenerated from the project itself.

# Compiled binaries and intermediate build artifacts
Binaries/
Build/
Intermediate/
DerivedDataCache/
Saved/

# Per-plugin build output (source plugins are still tracked)
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Editor-generated project files (regenerated by "Generate Visual Studio project files")
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Blender automatic backups of the source files under Resources/ (the .blend itself is tracked)
*.blend1

# OS files
.DS_Store
Thumbs.db

# Crash reports
CrashReportClient/

# Packaged builds
Saved/StagedBuilds/
